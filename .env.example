# Параметры окружения программного средства.
# Файл .env создается автоматически при первом запуске start.bat со случайными ключами.
# Ключи шифрования задаются в base64 (32 байта). Не публикуйте файл .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=loyalty_db
JWT_SECRET_KEY=
PII_ENCRYPTION_KEY=
PII_HMAC_KEY=
BACKUP_ENCRYPTION_KEY=
CORS_ORIGINS=https://localhost:8443
